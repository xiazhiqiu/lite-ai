{
  "name": "lite-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lite-ai": "./bin/lite-ai"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "check:web": "tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint src test",
    "test": "node test/run-tests.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "check:tracing": "tsx scripts/check-tracing.mjs",
    "eval:itbench": "tsx src/eval/itbench/index.ts",
    "install-local": "tsx src/install.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "better-sqlite3": "^13.0.3",
    "diff": "^8.0.4",
    "mysql2": "^3.23.4",
    "pg": "^8.23.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "9.39.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.46.4",
    "vite": "^7.2.0"
  }
}
